<?xml version="1.0" encoding="utf-8"?>
<!--
  Scoped to the windows/ solution. The machine-wide NuGet.Config has an empty
  <packageSources> element, which clears the implicit nuget.org default and makes
  every restore fail with NU1100. Re-add nuget.org here so this solution restores
  without changing global machine state.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
